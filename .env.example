# Copy to .env and replace the placeholders. The real .env is git-ignored.
# The SQL password is embedded in a connection string: do not use ';' in it.
# SQL Server requires 8+ chars with 3 of: upper, lower, digit, symbol.
MSSQL_DATABASE=ClinicBooking
MSSQL_SA_PASSWORD=CHANGE_ME_dummy_sql_password_1

# HS256 signing key for access tokens: at least 32 characters, random, never reused elsewhere.
JWT_SIGNING_KEY=CHANGE_ME_dummy_local_jwt_signing_key

# First user, created at startup only when no user exists. Password policy: at least 12
# characters with an upper-case letter, a lower-case letter and a digit.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_ME_dummy_Seed_password_1
