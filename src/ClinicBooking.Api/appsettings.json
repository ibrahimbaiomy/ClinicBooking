{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ClinicBooking",
    "Audience": "ClinicBooking",
    "AccessTokenMinutes": 15,
    "ClockSkewSeconds": 30
  },
  "Auth": {
    "RefreshTokenDays": 7,
    "SessionMaxDays": 30,
    "ReuseGraceSeconds": 10,
    "CleanupRetentionDays": 7,
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "LoginPerMinute": 10,
    "RefreshPerMinute": 30
  }
}
